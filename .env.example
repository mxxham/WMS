# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Login (spec 2026-10-12): empty or false = today's behaviour, every visitor is signed in as the
# shared site account below and /login is optional; true = everyone signs in with their own account.
LOGIN_REQUIRED=
# Shared site account (an admin in Supabase Auth), used while LOGIN_REQUIRED is not true.
SITE_ACCOUNT_EMAIL=
SITE_ACCOUNT_PASSWORD=
